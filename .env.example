# 复制后填写：cp .env.example .env
# 本文件可提交；真实密钥只写在 .env（已 gitignore）

# ════════════════════════════════════════════════════════
# PostgreSQL
# ────────────────────────────────────────────────────────
# 本地自建（默认）：host=127.0.0.1，sslmode=disable 或 prefer
# 云 RDS：host=实例地址，sslmode=require
# ════════════════════════════════════════════════════════
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=api
DB_USER=postgres
DB_PASSWORD=change_me
# disable=本地无 SSL；prefer=能开就开；require=云库常用
DB_SSLMODE=disable

# ════════════════════════════════════════════════════════
# 日志
# ════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# ════════════════════════════════════════════════════════
# PlayNow 主源（必须代理；Akamai 会拦多数非北美直连）
# ════════════════════════════════════════════════════════
PLAYNOW_PRIMARY_URL=https://www.playnow.com/services2/keno/nextdraw/
PLAYNOW_FALLBACK_URL=https://www.playnow.com/services2/keno/draw/latest/10

# 代理分段填写（程序会拼成 socks5://用户:密码@IP:端口）
# 协议：socks5 / http / https
PLAYNOW_PROXY_SCHEME=socks5
PLAYNOW_PROXY_USER=your_proxy_user
PLAYNOW_PROXY_PASSWORD=your_proxy_password
PLAYNOW_PROXY_HOST=1.2.3.4
PLAYNOW_PROXY_PORT=1080

# ════════════════════════════════════════════════════════
# pc28.help 备用源（直连，无需代理）
# ════════════════════════════════════════════════════════
KENO_API_URL=https://pc28.help/api/keno.json?nbr=1
